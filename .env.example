# Copy this file to `.env` and fill in values from the Supabase dashboard:
# Project Settings → API → Project URL & anon public key
#
# Never put real secrets in `.env.example` (this file is committed to git).
# Never commit `.env` (it is gitignored).

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# Optional: shown in Sentry release tag / health checks
VITE_APP_VERSION=0.0.1

# Optional: Sentry browser DSN (leave empty to disable in production bundle)
VITE_SENTRY_DSN=

# ── Deferred modules (feature switches) ──
# Each module ships OFF and needs the EXACT string 'true' to appear; anything
# else (1, TRUE, yes) keeps it off. The frontend switch only decides what users
# SEE — the matching server flag (FEATURE_*_ENABLED, set with
# `supabase secrets set`) decides what the API allows, so set BOTH or the page
# will look available and the API will answer 410.
#   VITE_FEATURE_CONTESTS_ENABLED=true     + FEATURE_CONTESTS_ENABLED=true
#   VITE_FEATURE_INTERNSHIPS_ENABLED=true  + FEATURE_INTERNSHIPS_ENABLED=true
#   VITE_FEATURE_CERTIFICATES_ENABLED=true + FEATURE_CERTIFICATES_ENABLED=true
VITE_FEATURE_CONTESTS_ENABLED=false
VITE_FEATURE_INTERNSHIPS_ENABLED=false
VITE_FEATURE_CERTIFICATES_ENABLED=false

# AI model slug the frontend may display/probe. The real inference key is the
# edge-function secret AI_API_KEY — never a VITE_ var.
VITE_AI_MODEL=

# ════════════════════════════════════════════
# PAYMENT PROVIDERS
# ════════════════════════════════════════════

# ── PayPal (PRIMARY DISABLED — Coming Soon) ──
# PayPal is fully implemented in the backend but hidden in the UI until live
# credentials are provisioned. Set VITE_PAYPAL_ENABLED=true (and the keys below)
# to reveal the PayPal checkout options.
VITE_PAYPAL_ENABLED=false
# Get credentials: https://developer.paypal.com/dashboard/applications
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_SANDBOX=true

# PayPal Webhook (set up in PayPal Developer Dashboard → Webhooks)
# URL: https://YOUR_PROJECT_REF.supabase.co/functions/v1/paypal-webhook
PAYPAL_WEBHOOK_ID=

# ── Razorpay (PRIMARY payment gateway) ──
# Get credentials: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_ACCOUNT_NUMBER=

# Razorpay Checkout Config (dashboard → Settings → Checkout Configurations)
# Controls which payment methods show in the checkout (UPI / cards / net banking / EMI).
VITE_RAZORPAY_CONFIG_ID=

# Razorpay Webhook (set up in Razorpay Dashboard → Settings → Webhooks)
# URL: https://YOUR_PROJECT_REF.supabase.co/functions/v1/razorpay-webhook
# Events: order.paid, payment.captured, payment.failed, refund.processed
RAZORPAY_WEBHOOK_SECRET=

# ════════════════════════════════════════════
# APP URL (used for PayPal return URLs)
# ════════════════════════════════════════════
# ── AI Assistant / Matching / Support ──
# OpenRouter (https://openrouter.ai) — OpenAI-compatible gateway for all AI
# features: AI Assistant chat, AI ticket responder, AI-powered talent matching.
# Get a key from https://openrouter.ai/keys.
# Edge-function secrets ONLY — never expose to the frontend, never commit.
# Set via: supabase secrets set AI_API_KEY=... AI_BASE_URL=... AI_MODEL=...
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
# OpenRouter model slug (e.g. deepseek/deepseek-chat-v3-0324)
AI_MODEL=deepseek/deepseek-chat-v3-0324

# Optional local routing. Start the Respan Gateway (gateway.toml) and point this
# at its loopback origin; the AI client then asks for the `growlanzo-chat` /
# `growlanzo-priority` routes and the gateway chooses/retries the provider.
# Local only — keep it on 127.0.0.1. Leave empty in production (direct AI_BASE_URL).
# See docs/blueprint/BACKEND.md § AI gateway (Respan).
AI_GATEWAY_URL=

# ── Web search (Exa) ──
# Exa (https://exa.ai) powers the `exa-search` edge function: relevant pages
# plus highlighted excerpts that ground an answer in real sources.
# Edge-function secret ONLY — never a VITE_ var, never exposed to the frontend.
# Get a key from https://dashboard.exa.ai/api-keys, then:
#   supabase secrets set EXA_API_KEY=...
# Unset ⇒ the endpoint fails closed with 500 "Web search is not configured".
EXA_API_KEY=

# Canonical site origin. This is the ONLY place a domain lives for the backend:
# supabase/functions/_shared/site.ts reads it for every email logo/link, the PayPal
# return URLs and the AI attribution header. Changing this secret switches domains —
# no code edit, no redeploy of the links.
APP_URL=https://growlanzo.com

# ════════════════════════════════════════════
# EMAIL
# ════════════════════════════════════════════
# Verification & password-reset emails are delivered by Supabase Auth's
# built-in sender (Dashboard → Authentication → Email → Confirm email ON,
# Custom SMTP OFF). No external SMTP provider is required.
#
# Transactional emails (support-ticket escalations, withdrawals, disputes,
# escrow, milestones, newsletters, internship offers) are sent by the edge
# functions via Brevo (shared helper supabase/functions/_shared/brevo.ts).
# Set via: supabase secrets set BREVO_API_KEY=xkeysib-...
# The from-address must be a verified Sender Identity at https://brevo.com —
# until then, only the account owner's own email receives deliveries. Never use
# the private owner Gmail as a From address; the four BREVO_FROM_* secrets above
# (or the EMAIL_FROM fallback) must be a verified @growlanzo.com sender.
# BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx (set in Supabase secrets, never commit a real key)
#
# Four verified sender identities (one per purpose). Use the address OR
# "Display Name <address>". Unset → the documented default address is used.
# BREVO_FROM_SECURITY=security@growlanzo.com
# BREVO_FROM_SUPPORT=support@growlanzo.com
# BREVO_FROM_HELLO=hello@growlanzo.com
# BREVO_FROM_INFO=info@growlanzo.com
#
# Shared secret for the Brevo delivery webhook. The webhook REJECTS every
# request while this is unset (fail-closed). Brevo does not HMAC-sign
# transactional payloads, so this is supplied as ?token=… , the
# x-brevo-webhook-secret header, or the basic-auth password.
# BREVO_WEBHOOK_SECRET=generate-a-long-random-string
# EMAIL_FROM=Growlancer <no-reply@growlanzo.com>
# EMAIL_REPLY_TO=support@growlanzo.com
